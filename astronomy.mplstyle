# CUSTOM MATPLOTLIB STYLE SHEET FILE
# Author : Neil Ghugare

# --- Typography & Fonts ---
font.family         : sans-serif
font.sans-serif     : DejaVu Sans, Helvetica, Arial
font.size           : 13
axes.labelsize      : 16
axes.titlesize      : 14
xtick.labelsize     : 13
ytick.labelsize     : 13
legend.fontsize     : 12

# --- Line and Marker Weights ---
lines.linewidth     : 1.5
patch.linewidth     : 1.0
axes.linewidth      : 1.5

# --- Ticks ---
xtick.direction     : in
ytick.direction     : in
xtick.top           : True
ytick.right         : True
xtick.minor.visible : True
ytick.minor.visible : True

# --- Tick Sizing & Length ---
xtick.major.size    : 6.0
xtick.minor.size    : 3.0
ytick.major.size    : 6.0
ytick.minor.size    : 3.0
xtick.major.width   : 1.5
xtick.minor.width   : 1.0
ytick.major.width   : 1.5
ytick.minor.width   : 1.0

# Figure Layout & Saving Options ---
figure.dpi          : 150
savefig.dpi         : 300
savefig.bbox        : tight

# --- Grid Styling ---
axes.grid           : True
grid.linestyle      : --
grid.alpha          : 0.5
grid.color          : gray
grid.linewidth      : 0.8

# --- Bolding ---
axes.labelweight    : bold
axes.titleweight    : bold
font.weight	    : bold

# --- My Custom Coloring ---
axes.prop_cycle : cycler('color', ['14213D', 'C84B31', 'E69F00', '56B4E9', '5C2A5D'])